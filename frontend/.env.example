# ============================================================
#  Bergslagsleden Ultra – frontend miljövariabler (exempel)
#  Kopiera till ".env" och fyll i din backend-URL.
#      cp .env.example .env
# ============================================================

# Publik URL till backend (inklusive https://).
# Frontend anropar {REACT_APP_BACKEND_URL}/api/...
# Vid self-hosting bakom nginx pekar denna oftast på samma domän som sidan.
REACT_APP_BACKEND_URL=https://bergslagsledenultra.se
