# ============================================================
#  Bergslagsleden Ultra – backend miljövariabler (exempel)
#  Kopiera denna fil till ".env" och fyll i riktiga värden.
#      cp .env.example .env
# ============================================================

# --- Databas (MongoDB) ---
# Lokal MongoDB på servern, ELLER en MongoDB Atlas connection string.
MONGO_URL=mongodb://localhost:27017
DB_NAME=bergslagsleden_ultra

# --- CORS / frontend ---
# Tillåtna frontend-URL:er, kommaseparerade.
CORS_ORIGINS=https://bergslagsledenultra.se

# --- Autentisering (funktionär/admin) ---
# Byt JWT_SECRET till en lång slumpmässig sträng, t.ex:  openssl rand -hex 32
JWT_SECRET=byt-till-en-lang-slumpmassig-hemlighet
ADMIN_EMAIL=admin
ADMIN_PASSWORD=byt-detta-losenord
# Sätt false för lokal HTTP-utveckling och true i produktion med HTTPS.
COOKIE_SECURE=true
# lax fungerar när frontend och API ligger på samma webbplats.
COOKIE_SAMESITE=lax

# --- E-post via Resend -------------------------------------
#   1. Skapa konto på https://resend.com
#   2. Verifiera din avsändardomän (t.ex. bergslagsledenultra.se)
#   3. Skapa en API-nyckel och klistra in nedan
#   RESEND_FROM måste vara en adress på din verifierade domän.
RESEND_API_KEY=
RESEND_FROM=Bergslagsleden Ultra <noreply@bergslagsledenultra.se>
# Visningsnamn för avsändaren.
EMAIL_FROM_NAME=Bergslagsleden Ultra
